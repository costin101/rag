# Copy to .env (git-ignored) and fill in real values. Placeholders below are fake.
# Nothing loads .env automatically: export these variables in your shell or use your own loader.
ANTHROPIC_API_KEY=replace-me
RAG_PROVIDER=anthropic
RAG_MODEL=claude-sonnet-5-5
RAG_MAX_TOKENS=1024
RAG_PROVIDER_TIMEOUT_S=30
RAG_PROVIDER_MAX_RETRIES=2

QDRANT_URL=https://qdrant.example.invalid:6333
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=replace-me
QDRANT_TIMEOUT_S=10

RAG_TOP_K=5
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Full commit hash of the repo the embedder downloads from (for the default model that is
# Qdrant/bge-small-en-v1.5-onnx-Q, not BAAI); defaults to that pinned hash.
# Required when RAG_EMBED_MODEL is set to any other model.
# RAG_EMBED_REVISION=<40-char commit hash>
# RAG_EMBED_CACHE_DIR=/path/to/embedding/cache
