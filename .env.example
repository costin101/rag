# Copy to .env (git-ignored) and fill in real values. Placeholders below are fake.
# Nothing loads .env automatically: export these variables in your shell or use your own loader.
ANTHROPIC_API_KEY=replace-me
RAG_PROVIDER=anthropic
RAG_MODEL=claude-sonnet-5-5
RAG_MAX_TOKENS=1024
RAG_PROVIDER_TIMEOUT_S=30
RAG_PROVIDER_MAX_RETRIES=2
# Longest wait before one retry, in seconds (0 < n <= 600), even if the server asks for more.
RAG_PROVIDER_MAX_RETRY_WAIT_S=60
# API host the key is sent to (https only; the ambient ANTHROPIC_BASE_URL is ignored).
# RAG_PROVIDER_BASE_URL=https://api.anthropic.com

QDRANT_URL=https://qdrant.example.invalid:6333
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=replace-me
QDRANT_TIMEOUT_S=10

RAG_TOP_K=5
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Full commit hash of the repo the embedder downloads from (for the default model that is
# Qdrant/bge-small-en-v1.5-onnx-Q, not BAAI); defaults to that pinned hash.
# Required when RAG_EMBED_MODEL is set to any other model.
# RAG_EMBED_REVISION=<40-char commit hash>
# RAG_EMBED_CACHE_DIR=/path/to/embedding/cache
# Hub the embedder downloads from (https only; the ambient HF_ENDPOINT and HF_TOKEN are ignored).
# RAG_EMBED_ENDPOINT=https://huggingface.co

# Container path (all optional: the API path runs without them; the container path needs
# NOMAD_ADDR and RAG_CONTAINER_IMAGE).
# NOMAD_ADDR=http://127.0.0.1:4646
# Sent as X-Nomad-Token; NOMAD_ADDR must then be https.
# NOMAD_TOKEN=replace-me
# CA bundle for a Nomad server with a private certificate.
# NOMAD_CACERT=/path/to/nomad-ca.pem
# Letters, digits and '-' only.
# NOMAD_NAMESPACE=default
# Digest-pinned only: <name>@sha256:<64 hex digits> (a tag can move).
# RAG_CONTAINER_IMAGE=registry.example.invalid/rag-container@sha256:<64 hex digits>
RAG_CONTAINER_CPU_MHZ=500
# Hard limit per session container (64 <= n <= 8192).
RAG_CONTAINER_MEMORY_MB=128
# Deadline for one container run, in seconds (0 < n <= 600).
RAG_CONTAINER_TIMEOUT_S=60
# Largest query + context sent to the container, and largest stdout read back, in bytes.
RAG_CONTAINER_MAX_INPUT_BYTES=262144
RAG_CONTAINER_MAX_OUTPUT_BYTES=65536
